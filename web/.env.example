# Google Maps Platform API key with the Solar API enabled (server) + Maps JavaScript API (browser).
GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Lucenia node (OpenSearch-wire-compatible). Default docker compose maps 9200.
ENGINE_URL=https://localhost:9200
LUCENIA_ADMIN_PASSWORD=RoofRank!2026Dev

# In-engine AI (Lucenia ml-commons). Used only by `npm run ml-setup`, which
# registers the remote LLM inside the cluster. The app never reads these — the
# API calls the engine by pipeline name, so credentials stay in-cluster.
#
# PROVIDER SUPPORT on skylite 0.11.0/0.11.1 (verified):
#   bedrock (aws_sigv4) -> WORKS in-engine. Use this.
#   openai/openrouter (http) -> the http connector executor is BROKEN on this
#   build, so the model fails to DEPLOY. Kept for a future Lucenia fix.
LLM_PROVIDER=bedrock

# --- Bedrock (working in-engine path) ---
# IAM principal needs bedrock:InvokeModel; enable the model in the Bedrock
# console for AWS_REGION. Free-tier AWS account is fine; Claude Hauku is pennies.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=            # only if using temporary STS creds
AWS_REGION=us-east-1
# Bedrock model id (default anthropic.claude-3-haiku-20240307-v1:0)
LLM_MODEL=anthropic.claude-3-haiku-20240307-v1:0

# --- http providers (deploy is broken on this build; do not use for RAG yet) ---
OPENAI_API_KEY=
OPENROUTER_API_KEY=
